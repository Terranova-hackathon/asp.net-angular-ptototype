# Copy this file to .env (which is git-ignored) and fill it in.

# SQL Server 'sa' password: 8+ chars with upper, lower, digit and symbol.
# Avoid ; and " characters because it is placed inside a connection string.
SA_PASSWORD=

# Secret used to sign login tokens: at least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_KEY=

# Free key from https://rawg.io/apidocs
RAWG_API_KEY=

# Steam Web API key from https://steamcommunity.com/dev/apikey (needed for the profile page)
STEAM_API_KEY=
